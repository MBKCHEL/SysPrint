# Maintainer: MBKCHEL <mbkchelofficialdev@gmail.com>
pkgname=sysprint-git
pkgver=2.5.0.r1.g8ae39d0
pkgrel=1
pkgdesc="A lightweight system information fetch tool written in Rust"
arch=('x86_64')
url="https://github.com/MBKCHEL/SysPrint"
license=('MIT')
depends=('gcc-libs')
makedepends=('cargo' 'git')
provides=('sysprint')
conflicts=('sysprint' 'sysprint-bin')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "SysPrint"
  git describe --long --tags 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || echo "0.1.0"
}

build() {
  cd "SysPrint"
  RUSTFLAGS="" cargo build --release --locked
}

package() {
  cd "SysPrint"
  install -Dm755 "target/release/sysprint" "$pkgdir/usr/bin/sysprint"
}
